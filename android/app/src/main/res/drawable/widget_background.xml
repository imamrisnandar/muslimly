<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF0F4A40"
                android:centerColor="#FF0C2F33"
                android:endColor="#FF08161E"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#33FFD54F" />
        </shape>
    </item>
</layer-list>
